<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12以降（API 31+）向けのバックアップ・端末間移行の除外ルール。
  API 30以前は backup_rules.xml（fullBackupContent）が使われる。
  除外理由はbackup_rules.xmlのコメント参照。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="serendipity_spot_cache.xml" />
        <exclude domain="sharedpref" path="serendipity_spot_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="serendipity_spot_cache.xml" />
        <exclude domain="sharedpref" path="serendipity_spot_auth.xml" />
    </device-transfer>
</data-extraction-rules>
